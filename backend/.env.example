# Copy to backend/.env and start with:  .venv/bin/uvicorn server:app --port 8000 --env-file .env
# All values are optional; these are the defaults.

# LM Studio's OpenAI-compatible server
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Chat model used by both agents
LM_STUDIO_MODEL=qwen/qwen3-4b
# Embedding model used for the Chroma vector store
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
