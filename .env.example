# SQLite is the default for local development; Docker Compose sets PostgreSQL + pgvector.
DATABASE_URL=sqlite:///./requirements.db
JWT_SECRET=replace-with-at-least-32-random-characters-before-deployment
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional OpenAI-compatible provider. Rules always determine priority and completion.
# Stakeholder conversation content will be sent to the configured provider when enabled.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
